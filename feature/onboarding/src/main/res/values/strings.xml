    <string name="onboarding_welcome_title">Bienvenue sur Roadly</string>
    <string name="onboarding_welcome_subtitle">Le GPS qui vous guide sans revendre vos données. Quelques réglages, et c\'est parti.</string>
    <string name="onboarding_welcome_guidance_title">Guidage vocal pas à pas</string>
    <string name="onboarding_welcome_guidance_body">Voies conseillées, ronds-points avec le numéro de sortie, carrefours en 3D et recalcul immédiat.</string>
    <string name="onboarding_welcome_horizon_title">Horizon</string>
    <string name="onboarding_welcome_horizon_body">La route à venir en un coup d\'œil : prochaines manœuvres, virages serrés, zones de vigilance et signalements.</string>
    <string name="onboarding_welcome_vigilance_title">Zones de vigilance</string>
    <string name="onboarding_welcome_vigilance_body">Liste officielle, jamais un point exact : une zone où rester prudent, annoncée à l\'avance.</string>
    <string name="onboarding_welcome_community_title">Communauté</string>
    <string name="onboarding_welcome_community_body">Accident, bouchon, objet sur la route : signalez en un geste, les autres conducteurs le voient sur leur trajet.</string>

    <string name="onboarding_location_title">Votre position</string>
    <string name="onboarding_location_subtitle">Indispensable pour la carte, le calcul des itinéraires et le guidage.</string>
    <string name="onboarding_location_card_title">Reste sur votre téléphone</string>
    <string name="onboarding_location_card_body">Roadly lit votre position pour vous situer et vous guider. Elle n\'est ni stockée sur un serveur, ni vendue.</string>
    <string name="onboarding_location_card_note">Un signalement envoie seulement sa position, au moment où vous le faites.</string>
    <string name="onboarding_location_granted">Localisation autorisée</string>
    <string name="onboarding_location_pending">Pas encore autorisée</string>
    <string name="onboarding_location_denied_forever">Refusée : à autoriser dans les réglages d\'Android</string>

    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_subtitle">Le guidage reste visible quand l\'écran est verrouillé ou qu\'une autre appli est ouverte.</string>
    <string name="onboarding_notifications_card_title">Guidage en arrière-plan</string>
    <string name="onboarding_notifications_card_body">La notification affiche la prochaine manœuvre et l\'heure d\'arrivée, avec un bouton « Arrêter ». Sans elle, le guidage fonctionne quand même.</string>
    <string name="onboarding_notifications_granted">Notifications autorisées</string>
