<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android Auto : gabarits de navigation et dessin de la carte sur l'écran de la voiture. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Niveau 1 : tous les hôtes Android Auto. Un niveau plus haut masque Roadly du lanceur des voitures dont l'hôte négocie
             moins. Les gabarits suivent le niveau négocié (CarTemplates) : MapWithContentTemplate à partir de 7, gabarits de
             navigation historiques en dessous. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name="fr.roadly.feature.car.RoadlyCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
            <!-- « Navigue vers … » (Assistant) et autres applications de la voiture : geo:lat,lon ou geo:0,0?q=adresse. -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>
    </application>
</manifest>
