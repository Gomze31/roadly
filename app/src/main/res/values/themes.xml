<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Roadly" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0E0B14</item>
    </style>

    <!-- Widget : une action = icône + libellé, zone cliquable arrondie. -->
    <style name="Widget.Roadly.Action" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/widget_action_bg</item>
    </style>
    <style name="Widget.Roadly.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
