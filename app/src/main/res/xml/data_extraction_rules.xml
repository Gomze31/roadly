<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : allowBackup=false ne couvre plus le transfert d'appareil à appareil. Favoris, historique, trajets et
     réglages ne quittent jamais le téléphone, ni par la sauvegarde dans le cloud ni par le transfert vers un autre appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
